{
  "name": "dsh-xhs-style",
  "version": "1.1.0",
  "private": false,
  "license": "MIT",
  "description": "Adds multi-round requirements discovery before product selection and competitive analysis, then formats confirmed reports as Xiaohongshu-style posts with concrete details, audited images, source links, and a banned-slang filter.",
  "keywords": ["dsh", "cordis", "plugin", "prompt", "xiaohongshu", "requirements-discovery", "product-selection", "formatting", "chinese", "emoji"],
  "type": "module",
  "scripts": {
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Refreshing-CZQ/dsh-xhs-style.git"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
